<?xml version="1.0" encoding="UTF-8"?>
<!-- 独立 assembly 描述符：定义单体应用分发包结构 -->
<!-- 分发包结构（thin jar + 外置依赖）： -->
<!-- standalone-runner-1.0-SNAPSHOT/ -->
<!-- ├── lib/standalone-runner.jar   thin jar（仅应用代码） -->
<!-- ├── lib/*.jar                   全部运行时依赖 -->
<!-- ├── conf/application.yml        打包时从 src/main/resources/application.yml 复制（与 jar 内配置同源） -->
<!-- ├── web/                        外置 web 静态资源（优先于 jar 内资源） -->
<!-- ├── .logs/                      日志存放目录（运行期由 logback 与启动脚本自动创建，过月日志压缩归档到 .logs/archive） -->
<!-- └── bin/                        启动 / 停止 / 重启 / 日志归档脚本（sh + bat） -->
<assembly xmlns="http://maven.apache.org/ASSEMBLY/2.2.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/ASSEMBLY/2.2.0 https://maven.apache.org/xsd/assembly-2.2.0.xsd">
    <id>dist</id>
    <formats>
        <format>zip</format>
        <format>dir</format>
    </formats>
    <includeBaseDirectory>true</includeBaseDirectory>
    <baseDirectory>${project.build.finalName}</baseDirectory>

    <!-- 应用 thin jar（maven-jar-plugin 默认产物，不含依赖） -->
    <files>
        <file>
            <source>${project.build.directory}/${project.build.finalName}.jar</source>
            <outputDirectory>lib</outputDirectory>
            <destName>standalone-runner.jar</destName>
        </file>
        <!-- 外置 application.yml 来自打包时的主配置文件，与 jar 内配置同源，不单独维护 -->
        <file>
            <source>src/main/resources/application.yml</source>
            <outputDirectory>conf</outputDirectory>
        </file>
    </files>

    <!-- 全部运行时依赖外置到 lib 目录，启动脚本通过 java -cp "lib/*" 加载 -->
    <dependencySets>
        <dependencySet>
            <outputDirectory>lib</outputDirectory>
            <scope>runtime</scope>
            <useProjectArtifact>false</useProjectArtifact>
        </dependencySet>
    </dependencySets>

    <!-- 独立资源：外置配置与启动脚本 -->
    <fileSets>
        <!-- 外置日志配置（application.yml 由上方 files 从主配置复制） -->
        <fileSet>
            <directory>src/main/resources/conf</directory>
            <outputDirectory>conf</outputDirectory>
        </fileSet>
        <fileSet>
            <directory>src/main/resources/bin</directory>
            <outputDirectory>bin</outputDirectory>
            <fileMode>0755</fileMode>
        </fileSet>
        <!-- 外置 web 静态资源：可直接修改，无需重新打包 -->
        <fileSet>
            <directory>src/main/resources/web</directory>
            <outputDirectory>web</outputDirectory>
        </fileSet>
        <!-- 日志目录 .logs 不随包分发：logback 与启动脚本会自动创建 -->
    </fileSets>
</assembly>
