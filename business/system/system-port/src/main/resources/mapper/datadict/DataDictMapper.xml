<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.kacean.boot.datadict.port.infra.mapper.DataDictMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.kacean.boot.datadict.port.infra.entity.DataDictEntity">
        <id column="id" property="id" />
        <result column="external_no" property="externalNo" />
        <result column="deleted" property="deleted" />
        <result column="create_at" property="createAt" />
        <result column="create_by" property="createBy" />
        <result column="modify_at" property="modifyAt" />
        <result column="modify_by" property="modifyBy" />
        <result column="version" property="version" />
        <result column="dict_name" property="dictName" />
        <result column="is_enabled" property="isEnabled" />
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        id,
        external_no,
        deleted,
        create_at,
        create_by,
        modify_at,
        modify_by,
        version,
        dict_name, is_enabled
    </sql>

</mapper>
