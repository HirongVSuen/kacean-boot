    <dependencies>
        <!-- 通过依赖获得 Spring DI 与 JPA API，不再继承 common-app -->
        <dependency>
            <groupId>com.kacean.power</groupId>
            <artifactId>common-app</artifactId>
            <version>${project.version}</version>
        </dependency>
    </dependencies>

