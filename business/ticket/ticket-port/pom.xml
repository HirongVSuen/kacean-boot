<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.kacean.boot</groupId>
        <artifactId>ticket</artifactId>
        <version>1.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>ticket-port</artifactId>
    <description>工单-端口层：web 包承载 Spring MVC Controller、DTO、assembler，infra 包承载持久化与外部适配；贫血 CRUD 允许 web 直调 infra</description>

    <properties>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <!-- web 包：通过依赖获得最小 Spring MVC，不再继承 common-web -->
        <dependency>
            <groupId>com.kacean.boot</groupId>
            <artifactId>common-web</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- infra 包：基础设施公共依赖，不再继承 common-infra -->
        <dependency>
            <groupId>com.kacean.boot</groupId>
            <artifactId>common-infra</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- DDD 适配方向为 port → app；app 不反向依赖 port -->
        <dependency>
            <groupId>com.kacean.boot</groupId>
            <artifactId>ticket-app</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-webmvc</artifactId>
                <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-core</artifactId>
        </dependency>

    </dependencies>

</project>
